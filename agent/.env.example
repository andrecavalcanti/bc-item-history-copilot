# Microsoft Foundry
# Project endpoint from the Foundry portal home page, e.g.
# https://bc-copilot-lab-resource.services.ai.azure.com/api/projects/bc-copilot-lab
PROJECT_ENDPOINT=
# Name of your chat model deployment, e.g. gpt-5.2
MODEL_DEPLOYMENT=
# Name of the OAuth MCP connection you create in Foundry (step 4 of the README)
MCP_CONNECTION_NAME=bc-mcp
AGENT_NAME=drop-ship-investigator

# Business Central online
BC_TENANT_ID=
BC_ENVIRONMENT=Sandbox
BC_COMPANY=CRONUS USA, Inc.
# Name of the MCP configuration you create in Business Central (step 3 of the README)
BC_MCP_CONFIGURATION=DropShipInvestigator
